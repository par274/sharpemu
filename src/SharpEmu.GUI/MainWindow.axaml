<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SharpEmu.GUI"
        xmlns:loc="clr-namespace:SharpEmu.GUI"
        xmlns:primitives="clr-namespace:Avalonia.Controls.Primitives;assembly=Avalonia.Controls"
        x:Class="SharpEmu.GUI.MainWindow"
        Title="SharpEmu"
        Width="1440"
        Height="900"
        MinWidth="980"
        MinHeight="640"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="None"
        ExtendClientAreaTitleBarHeightHint="92"
        Icon="avares://SharpEmu.GUI/Assets/SharpEmu.ico"
        KeyDown="OnKeyDown">

  <Grid x:Name="RootLayout" RowDefinitions="92,*,0" Background="#080B12">
    <Grid x:Name="MainContent" Grid.Row="0" Grid.RowSpan="2">
      <!-- Key art and the same three-layer atmosphere used by the WebUI. -->
      <Grid x:Name="BackdropLayer"
            Classes="backdropLayer"
            RenderTransformOrigin="50%,50%">
        <Grid.Transitions>
          <Transitions>
            <TransformOperationsTransition Property="RenderTransform"
                                           Duration="0:0:0.46"
                                           Easing="CubicEaseOut" />
          </Transitions>
        </Grid.Transitions>
        <Image x:Name="BackdropImage"
               Stretch="UniformToFill"
               Opacity="0"
               HorizontalAlignment="Center"
               VerticalAlignment="Center">
          <Image.Transitions>
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.46" />
            </Transitions>
          </Image.Transitions>
        </Image>
        <Grid ColumnDefinitions="32*,68*" IsHitTestVisible="False">
          <Image x:Name="CoverFallbackImage"
                 Grid.Column="1"
                 Stretch="Uniform"
                 Opacity="0"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Center">
            <Image.Transitions>
              <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.46" />
              </Transitions>
            </Image.Transitions>
          </Image>
        </Grid>
        <Border Background="#6B03060C" />
        <Border>
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
              <GradientStop Offset="0" Color="#EB05080F" />
              <GradientStop Offset="0.30" Color="#A605080F" />
              <GradientStop Offset="0.58" Color="#1F05080F" />
              <GradientStop Offset="1" Color="#0F05080F" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>
        <Border>
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,100%" EndPoint="0%,0%">
              <GradientStop Offset="0" Color="#FF060912" />
              <GradientStop Offset="0.18" Color="#C7060912" />
              <GradientStop Offset="0.58" Color="#0F060912" />
              <GradientStop Offset="1" Color="#33060912" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>
      </Grid>

      <Panel x:Name="PagesHost">
        <!-- Library: horizontal cover rail, then selected-game details. -->
        <Grid x:Name="LibraryPage" RowDefinitions="136,270,*,72">
          <Panel x:Name="CarouselHost"
                 Classes="carouselHost"
                 Grid.Row="1"
                 RenderTransformOrigin="50%,50%">
            <Panel.Transitions>
              <Transitions>
                <TransformOperationsTransition Property="RenderTransform"
                                               Duration="0:0:0.32"
                                               Easing="CubicEaseOut" />
                <DoubleTransition Property="Opacity"
                                  Duration="0:0:0.18"
                                  Easing="CubicEaseOut" />
              </Transitions>
            </Panel.Transitions>
            <ListBox x:Name="GameList"
                     Classes="tileGrid"
                     SelectionMode="Single"
                     Padding="64,0,64,0">
            <ListBox.ContextMenu>
              <ContextMenu x:Name="GameContextMenu" Placement="Pointer">
                <MenuItem x:Name="CtxLaunch" Header="Launch" FontWeight="SemiBold">
                  <MenuItem.Icon>
                    <TextBlock Classes="materialSymbol compact" Text="play_arrow" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="CtxGameSettings" Header="Game settings…">
                  <MenuItem.Icon>
                    <TextBlock Classes="materialSymbol compact" Text="settings" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="CtxOpenFolder" Header="Open game folder">
                  <MenuItem.Icon>
                    <TextBlock Classes="materialSymbol compact" Text="folder_open" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="CtxCopyPath" Header="Copy path">
                  <MenuItem.Icon>
                    <TextBlock Classes="materialSymbol compact" Text="content_copy" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="CtxCopyTitleId" Header="Copy title ID">
                  <MenuItem.Icon>
                    <TextBlock Classes="materialSymbol compact" Text="content_copy" />
                  </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem x:Name="CtxRemove"
                          Header="Remove from library"
                          Foreground="{StaticResource DangerHoverBrush}">
                  <MenuItem.Icon>
                    <TextBlock Classes="materialSymbol compact" Text="delete" />
                  </MenuItem.Icon>
                </MenuItem>
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="local:GameEntry">
                <Border Classes="coverShadow" Width="148" Height="198" CornerRadius="7">
                  <Border Classes="coverClip">
                    <Panel>
                      <Border Background="{Binding PlaceholderBrush}" IsVisible="{Binding !HasCover}">
                        <TextBlock Text="{Binding Initials}"
                                   FontSize="38"
                                   FontWeight="Light"
                                   LetterSpacing="-2"
                                   Foreground="#7AFFFFFF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                      </Border>
                      <Image Source="{Binding Cover}"
                             Stretch="UniformToFill"
                             IsVisible="{Binding HasCover}" />
                    </Panel>
                  </Border>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
            </ListBox>
          </Panel>

          <Grid Grid.Row="2" Margin="64,0,64,0" ColumnDefinitions="*,Auto">
            <StackPanel x:Name="SelectedDetailsHost"
                        Classes="selectedDetailsHost"
                        VerticalAlignment="Top"
                        MaxWidth="980"
                        HorizontalAlignment="Left">
              <StackPanel.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
                  <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" />
                </Transitions>
              </StackPanel.Transitions>
              <TextBlock x:Name="SelectedGameTitle"
                         Text="No game selected"
                         FontSize="52"
                         FontWeight="SemiBold"
                         LetterSpacing="-2"
                         LineHeight="74"
                         Margin="0,0,0,5"
                         TextWrapping="Wrap"
                         TextTrimming="CharacterEllipsis" />

              <StackPanel x:Name="SelectedBadgesRow"
                          x:DataType="local:GameEntry"
                          Orientation="Horizontal"
                          Spacing="54"
                          Margin="0,28,0,0"
                          IsVisible="False">
                <StackPanel Spacing="6">
                  <TextBlock x:Name="LastPlayedLabel" Classes="gameStatLabel" Text="Last played" />
                  <TextBlock x:Name="LastPlayedValue" Classes="gameStatValue" Text="Not played yet" />
                </StackPanel>
                <StackPanel Spacing="6" IsVisible="{Binding HasVersion, FallbackValue=False}">
                  <TextBlock x:Name="VersionLabel" Classes="gameStatLabel" Text="Version" />
                  <TextBlock Classes="gameStatValue" Text="{Binding VersionText}" />
                </StackPanel>
                <StackPanel Spacing="6">
                  <TextBlock x:Name="InstalledLabel" Classes="gameStatLabel" Text="Installed" />
                  <TextBlock Classes="gameStatValue" Text="{Binding SizeText}" />
                </StackPanel>
                <StackPanel Spacing="6" IsVisible="{Binding HasTitleId, FallbackValue=False}">
                  <TextBlock x:Name="TitleIdLabel" Classes="gameStatLabel" Text="Title ID" />
                  <TextBlock Text="{Binding TitleId}"
                             Classes="gameStatValue"
                             LetterSpacing="0.5" />
                </StackPanel>
              </StackPanel>

              <!-- Kept as native state holders for the existing launcher logic. -->
              <Panel x:Name="SelectedCoverPanel"
                     x:DataType="local:GameEntry"
                     Width="0"
                     Height="0"
                     IsVisible="False" />
              <TextBlock x:Name="SelectedGamePath"
                         Text="Pick a game from the library."
                         IsVisible="False" />
            </StackPanel>
          </Grid>

          <Grid x:Name="LaunchBar"
                Classes="launchBar"
                Grid.Row="3"
                Margin="64,0,64,22"
                ColumnDefinitions="Auto,Auto,Auto,*,Auto">
            <Grid.Transitions>
              <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" />
              </Transitions>
            </Grid.Transitions>
            <Button x:Name="LaunchButton"
                    Grid.Column="0"
                    Classes="accent"
                    IsEnabled="False">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="materialSymbol" Text="play_arrow" />
                <TextBlock x:Name="LaunchButtonLabel" Text="Play" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="StopButton"
                    Grid.Column="1"
                    Classes="danger"
                    Margin="10,0,0,0"
                    IsEnabled="False">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="materialSymbol" Text="stop" />
                <TextBlock x:Name="StopButtonLabel" Text="Stop" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="AddFolderButton"
                    Grid.Column="2"
                    Classes="ghost"
                    Margin="10,0,0,0">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="materialSymbol" Text="create_new_folder" />
                <TextBlock x:Name="AddFolderButtonLabel" Text="Add game" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
              <Button x:Name="OpenFileButton" Classes="ghost">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Classes="materialSymbol" Text="file_open" />
                  <TextBlock x:Name="OpenFileButtonLabel" Text="Open file" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="RescanButton" Classes="ghost">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Classes="materialSymbol" Text="refresh" />
                  <TextBlock x:Name="RescanButtonLabel" Text="Rescan" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <ToggleButton x:Name="ConsoleToggle" Classes="ghost">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock x:Name="ConsoleToggleLabel" Text="Options" VerticalAlignment="Center" />
                  <TextBlock Classes="materialSymbol" Text="more_vert" />
                </StackPanel>
              </ToggleButton>
            </StackPanel>
          </Grid>

          <StackPanel x:Name="EmptyState"
                      Grid.RowSpan="4"
                      Spacing="12"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsVisible="False">
            <TextBlock Text="YOUR PLAYGROUND AWAITS"
                       Classes="sectionTitle"
                       HorizontalAlignment="Center"
                       LetterSpacing="2.4" />
            <TextBlock x:Name="EmptyStateTitle"
                       Text="Your library is empty"
                       FontSize="66"
                       FontWeight="SemiBold"
                       LetterSpacing="-3"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="EmptyStateHint"
                       Text="Add a folder containing your games to get started."
                       FontSize="14"
                       Foreground="{StaticResource MutedBrush}"
                       HorizontalAlignment="Center" />
            <Button x:Name="EmptyAddFolderButton"
                    Classes="accent"
                    HorizontalAlignment="Center"
                    Margin="0,16,0,0">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="materialSymbol" Text="create_new_folder" />
                <TextBlock x:Name="EmptyAddFolderButtonLabel"
                           Text="Add game folder"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>

          <StackPanel x:Name="LoadingState"
                      Grid.RowSpan="4"
                      Spacing="22"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsVisible="False">
            <ProgressBar IsIndeterminate="True" Width="46" Height="3" />
            <TextBlock Text="SHARPEMU"
                       FontSize="13"
                       FontWeight="Bold"
                       LetterSpacing="3"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="LoadingStateText"
                       Text="Loading library…"
                       FontSize="12"
                       Foreground="{StaticResource MutedBrush}"
                       HorizontalAlignment="Center" />
          </StackPanel>

          <!-- Contextual per-game settings. The panel stays in the visual tree
               so the reveal and dismissal can animate without a second window. -->
          <Grid x:Name="GameOptionsOverlay"
                Classes="gameOptionsOverlay"
                Grid.RowSpan="4"
                RowDefinitions="2*,3*"
                IsHitTestVisible="False">
            <Grid.Transitions>
              <Transitions>
                <DoubleTransition Property="Opacity"
                                  Duration="0:0:0.2"
                                  Easing="CubicEaseOut" />
                <TransformOperationsTransition Property="RenderTransform"
                                               Duration="0:0:0.38"
                                               Easing="CubicEaseOut" />
              </Transitions>
            </Grid.Transitions>

            <Border Grid.Row="1"
                    Width="180"
                    Height="242"
                    Margin="84,-96,0,0"
                    ZIndex="2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    BoxShadow="0 26 54 0 #D1000000"
                    x:DataType="local:GameEntry">
              <Border Classes="coverClip"
                      Background="{Binding PlaceholderBrush}">
                <Panel>
                  <TextBlock Text="{Binding Initials}"
                             FontSize="28"
                             FontWeight="Medium"
                             Foreground="#A6FFFFFF"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             IsVisible="{Binding !HasCover}" />
                  <Image Source="{Binding Cover}"
                         Stretch="UniformToFill"
                         IsVisible="{Binding HasCover}" />
                </Panel>
              </Border>
            </Border>

            <Border Grid.Row="1"
                    Background="Transparent">
              <Grid RowDefinitions="Auto,*">
                <Border Grid.Row="1"
                        Background="{StaticResource GameOptionsMenuBrush}" />
                <Border Grid.Row="1"
                        Height="1"
                        ZIndex="1"
                        IsHitTestVisible="False"
                        VerticalAlignment="Top"
                        BoxShadow="0 18 42 0 #A6000000" />

                <Border Padding="300,18,64,14">
                  <Grid x:Name="GameOptionsIdentity"
                        x:DataType="local:GameEntry"
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="34">
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}"
                                 FontSize="42"
                                 FontWeight="SemiBold"
                                 LineHeight="54"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Path}"
                                 MaxWidth="680"
                                 HorizontalAlignment="Left"
                                 FontSize="11"
                                 Foreground="#99FFFFFF"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="34"
                                VerticalAlignment="Center">
                      <StackPanel Spacing="4">
                        <TextBlock x:Name="GameOptionsLastPlayedLabel"
                                   Classes="gameStatLabel"
                                   Text="Last played" />
                        <TextBlock x:Name="GameOptionsLastPlayedValue"
                                   Classes="gameStatValue"
                                   FontSize="15"
                                   Text="Not played yet" />
                      </StackPanel>
                      <StackPanel Spacing="4" IsVisible="{Binding HasVersion}">
                        <TextBlock x:Name="GameOptionsVersionLabel"
                                   Classes="gameStatLabel"
                                   Text="Version" />
                        <TextBlock Classes="gameStatValue"
                                   FontSize="15"
                                   Text="{Binding VersionText}" />
                      </StackPanel>
                      <StackPanel Spacing="4">
                        <TextBlock x:Name="GameOptionsInstalledLabel"
                                   Classes="gameStatLabel"
                                   Text="Installed" />
                        <TextBlock Classes="gameStatValue"
                                   FontSize="15"
                                   Text="{Binding SizeText}" />
                      </StackPanel>
                      <StackPanel Spacing="4" IsVisible="{Binding HasTitleId}">
                        <TextBlock x:Name="GameOptionsTitleIdLabel"
                                   Classes="gameStatLabel"
                                   Text="Title ID" />
                        <TextBlock Classes="gameStatValue"
                                   FontSize="15"
                                   Text="{Binding TitleId}" />
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </Border>

                <Grid Grid.Row="1"
                      Margin="64,12,64,8"
                      ColumnDefinitions="220,*"
                      ColumnSpacing="54">
                  <StackPanel Margin="0,62,0,0" Spacing="12">
                    <Button x:Name="GameOptionsLaunchButton"
                            Classes="gameOptionsLaunch">
                      <TextBlock x:Name="GameOptionsLaunchLabel"
                                 Classes="gameOptionsLaunchLabel"
                                 VerticalAlignment="Center"
                                 Text="Launch" />
                    </Button>

                    <Grid x:Name="GameOptionsNavHost"
                          Background="Transparent"
                          VerticalAlignment="Top">
                      <Border x:Name="GameOptionsNavIndicator"
                              Classes="gameOptionsNavIndicator"
                              Height="46"
                              IsHitTestVisible="False"
                              VerticalAlignment="Top"
                              BorderBrush="White"
                              BorderThickness="2"
                              CornerRadius="8">
                        <Border.RenderTransform>
                          <TranslateTransform>
                            <TranslateTransform.Transitions>
                              <Transitions>
                                <DoubleTransition Property="Y"
                                                  Duration="0:0:0.12"
                                                  Easing="CubicEaseOut" />
                              </Transitions>
                            </TranslateTransform.Transitions>
                          </TranslateTransform>
                        </Border.RenderTransform>
                      </Border>

                      <StackPanel Spacing="7">
                        <Button x:Name="GameOptionsGeneralNav"
                                Classes="gameOptionsNav active">
                          <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Classes="materialSymbol" Text="tune" />
                            <TextBlock x:Name="GameOptionsGeneralNavLabel"
                                       Classes="gameOptionsNavLabel"
                                       VerticalAlignment="Center"
                                       Text="General" />
                          </StackPanel>
                        </Button>
                        <Button x:Name="GameOptionsLoggingNav"
                                Classes="gameOptionsNav">
                          <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Classes="materialSymbol" Text="terminal" />
                            <TextBlock x:Name="GameOptionsLoggingNavLabel"
                                       Classes="gameOptionsNavLabel"
                                       VerticalAlignment="Center"
                                       Text="Logging" />
                          </StackPanel>
                        </Button>
                        <Button x:Name="GameOptionsEnvironmentNav"
                                Classes="gameOptionsNav">
                          <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Classes="materialSymbol" Text="deployed_code" />
                            <TextBlock x:Name="GameOptionsEnvironmentNavLabel"
                                       Classes="gameOptionsNavLabel"
                                       VerticalAlignment="Center"
                                       Text="Environment" />
                          </StackPanel>
                        </Button>
                        <Button x:Name="GameOptionsBackNav"
                                Classes="gameOptionsNav">
                          <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Classes="materialSymbol" Text="arrow_back" />
                            <TextBlock x:Name="GameOptionsBackNavLabel"
                                       Classes="gameOptionsNavLabel"
                                       VerticalAlignment="Center"
                                       Text="Back" />
                          </StackPanel>
                        </Button>
                      </StackPanel>
                    </Grid>
                  </StackPanel>

                  <Grid Grid.Column="1">
                    <ScrollViewer x:Name="GameOptionsGeneralPanel"
                                  HorizontalScrollBarVisibility="Disabled">
                      <StackPanel Spacing="12">
                        <local:SettingRow x:Name="GameStrictRow"
                                          Label="Strict dynlib resolution"
                                          Description="Fail the launch when an imported symbol cannot be resolved.">
                          <ToggleSwitch x:Name="GameStrictToggle" />
                        </local:SettingRow>

                        <WrapPanel Margin="0,12,0,0"
                                   ItemWidth="260"
                                   ItemHeight="54"
                                   Orientation="Horizontal">
                          <Button x:Name="GameOptionsOpenFolderButton"
                                  Classes="gameAction"
                                  Margin="0,0,10,10">
                            <StackPanel Orientation="Horizontal" Spacing="11">
                              <TextBlock Classes="materialSymbol" Text="folder_open" />
                              <TextBlock x:Name="GameOptionsOpenFolderLabel"
                                         VerticalAlignment="Center"
                                         Text="Open game folder" />
                            </StackPanel>
                          </Button>
                          <Button x:Name="GameOptionsCopyPathButton"
                                  Classes="gameAction"
                                  Margin="0,0,10,10">
                            <StackPanel Orientation="Horizontal" Spacing="11">
                              <TextBlock Classes="materialSymbol" Text="content_copy" />
                              <TextBlock x:Name="GameOptionsCopyPathLabel"
                                         VerticalAlignment="Center"
                                         Text="Copy path" />
                            </StackPanel>
                          </Button>
                          <Button x:Name="GameOptionsCopyTitleIdButton"
                                  Classes="gameAction"
                                  Margin="0,0,10,10">
                            <StackPanel Orientation="Horizontal" Spacing="11">
                              <TextBlock Classes="materialSymbol" Text="tag" />
                              <TextBlock x:Name="GameOptionsCopyTitleIdLabel"
                                         VerticalAlignment="Center"
                                         Text="Copy title ID" />
                            </StackPanel>
                          </Button>
                          <Button x:Name="GameOptionsRemoveButton"
                                  Classes="gameAction dangerAction"
                                  Margin="0,0,10,10">
                            <StackPanel Orientation="Horizontal" Spacing="11">
                              <TextBlock Classes="materialSymbol" Text="delete" />
                              <TextBlock x:Name="GameOptionsRemoveLabel"
                                         VerticalAlignment="Center"
                                         Text="Remove from library" />
                            </StackPanel>
                          </Button>
                        </WrapPanel>
                      </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="GameOptionsLoggingPanel"
                                  IsVisible="False"
                                  HorizontalScrollBarVisibility="Disabled">
                      <StackPanel Spacing="12">
                        <local:SettingRow x:Name="GameLogLevelRow"
                                          Label="Log level"
                                          Description="Verbosity of the emulator console output.">
                          <ComboBox x:Name="GameLogLevelBox" Width="170" />
                        </local:SettingRow>

                        <local:SettingRow x:Name="GameTraceRow"
                                          Label="Import trace limit"
                                          Description="Trace the first N imports per module.">
                          <NumericUpDown x:Name="GameTraceBox"
                                         Width="170"
                                         Minimum="0"
                                         Maximum="4096"
                                         Increment="16"
                                         FormatString="0" />
                        </local:SettingRow>

                        <local:SettingRow x:Name="GameLogToFileRow"
                                          Label="Log to file"
                                          Description="Mirror emulator output to a log file.">
                          <ToggleSwitch x:Name="GameLogToFileToggle" />
                        </local:SettingRow>
                      </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="GameOptionsEnvironmentPanel"
                                  IsVisible="False"
                                  HorizontalScrollBarVisibility="Disabled">
                      <StackPanel Spacing="12">
                        <TextBlock x:Name="GameOptionsEnvironmentDescription"
                                   MaxWidth="760"
                                   HorizontalAlignment="Left"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="Environment switches passed to the emulator for this game."
                                   TextWrapping="Wrap" />

                        <Grid x:Name="GameEnvironmentList"
                              Margin="0,8,0,0"
                              ColumnDefinitions="*,*"
                              RowDefinitions="Auto,Auto,Auto,Auto"
                              ColumnSpacing="24"
                              RowSpacing="8">
                          <ToggleSwitch x:Name="GameEnvBthidToggle"
                                        Grid.Row="0"
                                        OnContent="SHARPEMU_BTHID_UNAVAILABLE"
                                        OffContent="SHARPEMU_BTHID_UNAVAILABLE" />
                          <ToggleSwitch x:Name="GameEnvLoopGuardToggle"
                                        Grid.Row="1"
                                        OnContent="SHARPEMU_DISABLE_IMPORT_LOOP_GUARD"
                                        OffContent="SHARPEMU_DISABLE_IMPORT_LOOP_GUARD" />
                          <ToggleSwitch x:Name="GameEnvWritableApp0Toggle"
                                        Grid.Row="2"
                                        OnContent="SHARPEMU_WRITABLE_APP0"
                                        OffContent="SHARPEMU_WRITABLE_APP0" />
                          <ToggleSwitch x:Name="GameEnvVkValidationToggle"
                                        Grid.Row="3"
                                        OnContent="SHARPEMU_VK_VALIDATION"
                                        OffContent="SHARPEMU_VK_VALIDATION" />
                          <ToggleSwitch x:Name="GameEnvDumpSpirvToggle"
                                        Grid.Column="1"
                                        Grid.Row="0"
                                        OnContent="SHARPEMU_DUMP_SPIRV"
                                        OffContent="SHARPEMU_DUMP_SPIRV" />
                          <ToggleSwitch x:Name="GameEnvLogDirectMemoryToggle"
                                        Grid.Column="1"
                                        Grid.Row="1"
                                        OnContent="SHARPEMU_LOG_DIRECT_MEMORY"
                                        OffContent="SHARPEMU_LOG_DIRECT_MEMORY" />
                          <ToggleSwitch x:Name="GameEnvLogIoToggle"
                                        Grid.Column="1"
                                        Grid.Row="2"
                                        OnContent="SHARPEMU_LOG_IO"
                                        OffContent="SHARPEMU_LOG_IO" />
                          <ToggleSwitch x:Name="GameEnvLogNpToggle"
                                        Grid.Column="1"
                                        Grid.Row="3"
                                        OnContent="SHARPEMU_LOG_NP"
                                        OffContent="SHARPEMU_LOG_NP" />
                        </Grid>
                      </StackPanel>
                    </ScrollViewer>

                  </Grid>
                </Grid>

              </Grid>
            </Border>
          </Grid>
        </Grid>

        <!-- Options mirrors the former WebUI's single translucent settings column. -->
        <Grid x:Name="OptionsPage" IsVisible="False" RowDefinitions="124,*">
          <Border Grid.RowSpan="2" Background="#080B12" />
          <Border Grid.RowSpan="2">
            <Border.Background>
              <LinearGradientBrush StartPoint="100%,0%" EndPoint="35%,55%">
                <GradientStop Offset="0" Color="#2464A7FF" />
                <GradientStop Offset="0.42" Color="#00080B12" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <ScrollViewer Grid.Row="1" Margin="64,0,24,30">
            <StackPanel Width="1040" HorizontalAlignment="Left" Spacing="24">
              <StackPanel Spacing="8" Margin="0,0,0,16">
                <TextBlock Text="SHARPEMU / SYSTEM" Classes="sectionTitle" />
                <TextBlock Text="Options"
                           FontSize="66"
                           FontWeight="SemiBold"
                           LetterSpacing="-3" />
              </StackPanel>

              <Border Classes="optionsSurface">
                <StackPanel>
                  <Border Classes="card" BorderThickness="0">
                    <StackPanel Spacing="14">
                      <TextBlock x:Name="EmulationSectionTitle" Classes="sectionTitle" Text="EMULATION" />
                      <local:SettingRow x:Name="CpuEngineRow"
                                        Label="CPU engine"
                                        Description="Execution engine used to run game code.">
                        <ComboBox x:Name="CpuEngineBox" Width="160" SelectedIndex="0">
                          <ComboBoxItem x:Name="CpuEngineNativeItem" Content="Native" />
                        </ComboBox>
                      </local:SettingRow>
                      <local:SettingRow x:Name="StrictRow"
                                        Label="Strict dynlib resolution"
                                        Description="Fail the launch when an imported symbol cannot be resolved.">
                        <ToggleSwitch x:Name="StrictToggle" OnContent="On" OffContent="Off" />
                      </local:SettingRow>
                    </StackPanel>
                  </Border>

                  <Border Classes="card">
                    <StackPanel Spacing="14">
                      <TextBlock x:Name="LoggingSectionTitle" Classes="sectionTitle" Text="LOGGING" />
                      <local:SettingRow x:Name="LogLevelRow"
                                        Label="Log level"
                                        Description="Verbosity of the emulator console output.">
                        <ComboBox x:Name="LogLevelBox" Width="160" SelectedIndex="2">
                          <ComboBoxItem x:Name="LogLevelTraceItem" Content="Trace" />
                          <ComboBoxItem x:Name="LogLevelDebugItem" Content="Debug" />
                          <ComboBoxItem x:Name="LogLevelInfoItem" Content="Info" />
                          <ComboBoxItem x:Name="LogLevelWarningItem" Content="Warning" />
                          <ComboBoxItem x:Name="LogLevelErrorItem" Content="Error" />
                          <ComboBoxItem x:Name="LogLevelCriticalItem" Content="Critical" />
                        </ComboBox>
                      </local:SettingRow>
                      <local:SettingRow x:Name="TraceImportsRow"
                                        Label="Import trace limit"
                                        Description="Trace the first N imports per module (0 = off).">
                        <NumericUpDown x:Name="TraceImportsBox"
                                       Width="160"
                                       Minimum="0"
                                       Maximum="4096"
                                       Increment="16"
                                       Value="0"
                                       FormatString="0" />
                      </local:SettingRow>
                      <local:SettingRow x:Name="LogToFileRow"
                                        Label="Log to file"
                                        Description="Mirror emulator output to a log file.">
                        <ToggleSwitch x:Name="LogToFileToggle" OnContent="On" OffContent="Off" />
                      </local:SettingRow>
                      <local:SettingRow x:Name="LogFilePathRow"
                                        Label="Log file path"
                                        Description="No custom path">
                        <Button x:Name="SelectLogFilePathButton" Classes="ghost" Content="Select…" />
                      </local:SettingRow>
                      <local:SettingRow x:Name="OverrideLogFileRow"
                                        Label="Override log file"
                                        Description="Use the exact file path instead of appending title ID and timestamp.">
                        <ToggleSwitch x:Name="OverrideLogFileToggle" OnContent="On" OffContent="Off" />
                      </local:SettingRow>
                    </StackPanel>
                  </Border>

                  <Border Classes="card">
                    <StackPanel Spacing="14">
                      <TextBlock x:Name="LauncherSectionTitle" Classes="sectionTitle" Text="LAUNCHER" />
                      <local:SettingRow x:Name="LanguageRow"
                                        Label="Emulator language"
                                        Description="Language used throughout the launcher. Applies immediately.">
                        <ComboBox x:Name="LanguageBox" Width="160">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="local:Localization+LanguageInfo">
                              <TextBlock Text="{Binding NativeName}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </local:SettingRow>
                      <local:SettingRow x:Name="TitleMusicRow"
                                        Label="Title music"
                                        Description="Loop the selected game's preview music in the library.">
                        <ToggleSwitch x:Name="TitleMusicToggle" OnContent="On" OffContent="Off" IsChecked="True" />
                      </local:SettingRow>
                      <local:SettingRow x:Name="DiscordRow"
                                        Label="Discord presence"
                                        Description="Show the running game on your Discord profile.">
                        <ToggleSwitch x:Name="DiscordToggle" OnContent="On" OffContent="Off" />
                      </local:SettingRow>
                      <local:SettingRow x:Name="AutoUpdateRow"
                                        Label="Check for updates on startup"
                                        Description="Checks GitHub without delaying startup.">
                        <ToggleSwitch x:Name="AutoUpdateToggle" OnContent="On" OffContent="Off" IsChecked="True" />
                      </local:SettingRow>
                    </StackPanel>
                  </Border>

                  <Border Classes="card">
                    <StackPanel Spacing="14">
                      <TextBlock x:Name="RenderingSectionTitle" Classes="sectionTitle" Text="RENDERING" />
                      <local:SettingRow x:Name="RenderResolutionRow"
                                        Label="Internal resolution"
                                        Description="Render below native resolution and upscale on present. Takes effect on next launch.">
                        <ComboBox x:Name="RenderResolutionBox" Width="160" SelectedIndex="0">
                          <ComboBoxItem x:Name="RenderResolution100Item" Content="100% (native)" Tag="1.0" />
                          <ComboBoxItem x:Name="RenderResolution75Item" Content="75%" Tag="0.75" />
                          <ComboBoxItem x:Name="RenderResolution50Item" Content="50%" Tag="0.5" />
                          <ComboBoxItem x:Name="RenderResolution25Item" Content="25%" Tag="0.25" />
                        </ComboBox>
                      </local:SettingRow>
                    </StackPanel>
                  </Border>

                  <Border Classes="card">
                    <StackPanel Spacing="14">
                      <TextBlock x:Name="EnvSectionTitle" Classes="sectionTitle" Text="ENVIRONMENT" />
                      <TextBlock x:Name="EnvDesc"
                                 Text="Switches passed to the emulator as environment variables at launch."
                                 FontSize="11"
                                 Foreground="{StaticResource MutedBrush}"
                                 TextWrapping="Wrap" />
                      <local:SettingRow x:Name="EnvBthidRow"
                                        LabelFontFamily="Cascadia Mono,Consolas,monospace"
                                        Label="SHARPEMU_BTHID_UNAVAILABLE">
                        <ToggleSwitch x:Name="EnvBthidToggle" OnContent="On" OffContent="Off" />
                      </local:SettingRow>
                      <local:SettingRow x:Name="EnvLoopGuardRow"
                                        LabelFontFamily="Cascadia Mono,Consolas,monospace"
                                        Label="SHARPEMU_DISABLE_IMPORT_LOOP_GUARD">
                        <ToggleSwitch x:Name="EnvLoopGuardToggle" OnContent="On" OffContent="Off" />
                      </local:SettingRow>
                      <local:SettingRow x:Name="EnvWritableApp0Row"
                                        LabelFontFamily="Cascadia Mono,Consolas,monospace"
                                        Label="SHARPEMU_WRITABLE_APP0">
                        <ToggleSwitch x:Name="EnvWritableApp0Toggle" OnContent="On" OffContent="Off" />
                      </local:SettingRow>
                      <local:SettingRow x:Name="EnvVkValidationRow"
                                        LabelFontFamily="Cascadia Mono,Consolas,monospace"
                                        Label="SHARPEMU_VK_VALIDATION">
                        <ToggleSwitch x:Name="EnvVkValidationToggle" OnContent="On" OffContent="Off" />
                      </local:SettingRow>
                      <local:SettingRow x:Name="EnvDumpSpirvRow"
                                        LabelFontFamily="Cascadia Mono,Consolas,monospace"
                                        Label="SHARPEMU_DUMP_SPIRV">
                        <ToggleSwitch x:Name="EnvDumpSpirvToggle" OnContent="On" OffContent="Off" />
                      </local:SettingRow>
                      <local:SettingRow x:Name="EnvLogDirectMemoryRow"
                                        LabelFontFamily="Cascadia Mono,Consolas,monospace"
                                        Label="SHARPEMU_LOG_DIRECT_MEMORY">
                        <ToggleSwitch x:Name="EnvLogDirectMemoryToggle" OnContent="On" OffContent="Off" />
                      </local:SettingRow>
                      <local:SettingRow x:Name="EnvLogIoRow"
                                        LabelFontFamily="Cascadia Mono,Consolas,monospace"
                                        Label="SHARPEMU_LOG_IO">
                        <ToggleSwitch x:Name="EnvLogIoToggle" OnContent="On" OffContent="Off" />
                      </local:SettingRow>
                      <local:SettingRow x:Name="EnvLogNpRow"
                                        LabelFontFamily="Cascadia Mono,Consolas,monospace"
                                        Label="SHARPEMU_LOG_NP">
                        <ToggleSwitch x:Name="EnvLogNpToggle" OnContent="On" OffContent="Off" />
                      </local:SettingRow>
                    </StackPanel>
                  </Border>

                  <Border Classes="card">
                    <StackPanel Spacing="16">
                      <TextBlock x:Name="AboutSectionTitle" Classes="sectionTitle" Text="ABOUT" />
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock x:Name="LatestCommitLabel" Text="Latest commit" FontSize="13" />
                          <TextBlock x:Name="LatestCommitDescription"
                                     Text="Latest commit on the main branch"
                                     FontSize="11"
                                     Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                        <Button x:Name="LatestCommitHashText"
                                Grid.Column="1"
                                Classes="ghost"
                                Content="Loading…"
                                FontFamily="Cascadia Mono,Consolas,monospace"
                                IsEnabled="False" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock x:Name="UpdateLabel" Text="Updates" FontSize="13" />
                          <TextBlock x:Name="UpdateStatusText"
                                     Text="Current build: dev"
                                     FontSize="11"
                                     Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                        <Button x:Name="UpdateButton"
                                Grid.Column="1"
                                Classes="ghost"
                                Content="Check for updates" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock x:Name="GithubLabel" Text="GitHub" FontSize="13" />
                          <TextBlock x:Name="GithubDesc"
                                     Text="Source code, issues and project development."
                                     FontSize="11"
                                     Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                        <Button x:Name="GithubButton" Grid.Column="1" Classes="ghost" Content="Open" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock x:Name="DiscordServerLabel" Text="Discord" FontSize="13" />
                          <TextBlock x:Name="DiscordServerDesc"
                                     Text="Join the community, get support and follow development."
                                     FontSize="11"
                                     Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                        <Button x:Name="DiscordButton" Grid.Column="1" Classes="ghost" Content="Join" />
                      </Grid>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <!-- Console is a first-class page, as in the WebUI. -->
        <Grid x:Name="ConsolePanel" IsVisible="False" RowDefinitions="124,*">
          <Border Grid.RowSpan="2" Background="#080B12" />
          <Border Grid.RowSpan="2">
            <Border.Background>
              <LinearGradientBrush StartPoint="100%,0%" EndPoint="35%,55%">
                <GradientStop Offset="0" Color="#2464A7FF" />
                <GradientStop Offset="0.42" Color="#00080B12" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <Grid Grid.Row="1" Margin="64,0,64,30" RowDefinitions="Auto,*">
            <StackPanel Spacing="8" Margin="0,0,0,20">
              <TextBlock Text="SHARPEMU / RUNTIME" Classes="sectionTitle" />
              <TextBlock x:Name="ConsoleSectionTitle"
                         Text="Console"
                         FontSize="66"
                         FontWeight="SemiBold"
                         LetterSpacing="-3" />
            </StackPanel>
            <Border Grid.Row="1"
                    Background="#C70B0F17"
                    BorderBrush="#12FFFFFF"
                    BorderThickness="1"
                    CornerRadius="20"
                    ClipToBounds="True">
              <Grid RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="*,320,Auto,Auto,Auto,Auto"
                      Margin="18,14"
                      ColumnSpacing="10">
                  <TextBlock Text="LIVE OUTPUT"
                             Classes="sectionTitle"
                             VerticalAlignment="Center" />
                  <TextBox x:Name="ConsoleSearchBox"
                           Grid.Column="1"
                           FontSize="12"
                           PlaceholderText="Search…" />
                  <CheckBox x:Name="AutoScrollCheck"
                            Grid.Column="2"
                            Content="Auto-scroll"
                            IsChecked="True"
                            FontSize="12"
                            VerticalAlignment="Center" />
                  <Button x:Name="DetachConsoleButton"
                          Grid.Column="3"
                          Classes="ghost"
                          Content="Split" />
                  <Button x:Name="CopyLogButton"
                          Grid.Column="4"
                          Classes="ghost"
                          Content="Copy" />
                  <Button x:Name="ClearLogButton"
                          Grid.Column="5"
                          Classes="ghost"
                          Content="Clear" />
                </Grid>
                <ListBox x:Name="ConsoleList"
                         Grid.Row="1"
                         Classes="console"
                         BorderBrush="#12FFFFFF"
                         BorderThickness="0,1,0,0">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:LogLine">
                      <TextBlock Text="{Binding Text}"
                                 Foreground="{Binding Brush}"
                                 TextWrapping="NoWrap" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Panel>

      <!-- Native game surface must remain above the Avalonia shell. -->
      <Border x:Name="GameView"
              IsVisible="False"
              Background="#000000"
              ClipToBounds="True">
        <Grid x:Name="GameSurfaceContainer" />
      </Border>
    </Grid>

    <!-- 92 px WebUI top bar: brand, centered navigation, utility cluster. -->
    <Grid x:Name="TitleBar" Grid.Row="0">
      <Border>
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#9405080F" />
            <GradientStop Offset="1" Color="#0005080F" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <Grid x:Name="ContentToolbar"
            Margin="46,0"
            ColumnDefinitions="*,Auto,*">
        <StackPanel Orientation="Horizontal"
                    Spacing="11"
                    VerticalAlignment="Center">
          <Image Source="avares://SharpEmu.GUI/Assets/logo.png"
                 Width="46"
                 Height="46"
                 Stretch="Uniform" />
          <TextBlock x:Name="VersionText"
                     Text="v0.0.1"
                     FontSize="10"
                     Foreground="#70FFFFFF"
                     VerticalAlignment="Center"
                     Margin="4,1,0,0" />
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center">
          <Border Classes="padHint">
            <TextBlock Text="L1"
                       FontSize="9"
                       FontWeight="Bold"
                       Foreground="#07101D"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
          <Button x:Name="LibraryTabButton"
                  Classes="segment active"
                  Content="{Binding [Page.Library], Source={x:Static loc:Localization.Instance}}" />
          <Button x:Name="OptionsTabButton"
                  Classes="segment"
                  Content="{Binding [Page.Options], Source={x:Static loc:Localization.Instance}}" />
          <Border Classes="padHint">
            <TextBlock Text="R1"
                       FontSize="9"
                       FontWeight="Bold"
                       Foreground="#07101D"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
        </StackPanel>

        <StackPanel x:Name="LibraryToolbar"
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
          <TextBox x:Name="SearchBox"
                   Width="220"
                   Height="40"
                   IsVisible="False"
                   PlaceholderText="Search library…"
                   FontSize="12"
                   CornerRadius="20"
                   Padding="15,0" />
          <Button x:Name="ConsoleNavButton"
                  Classes="icon"
                  ToolTip.Tip="Console">
            <TextBlock Classes="materialSymbol" Text="terminal" />
          </Button>
          <Ellipse x:Name="StatusDot"
                   Width="7"
                   Height="7"
                   Fill="{StaticResource FaintBrush}"
                   Margin="9,0,7,0"
                   VerticalAlignment="Center" />
          <TextBlock x:Name="ClockText"
                     Text="00:00"
                     Width="48"
                     TextAlignment="Right"
                     FontSize="13"
                     Foreground="#D9FFFFFF"
                     VerticalAlignment="Center" />
          <Button x:Name="MinimizeButton"
                  Classes="icon"
                  ToolTip.Tip="Minimize">
            <TextBlock Classes="materialSymbol compact" Text="minimize" />
          </Button>
          <Button x:Name="MaximizeButton"
                  Classes="icon"
                  ToolTip.Tip="Maximize">
            <TextBlock Classes="materialSymbol compact" Text="crop_square" />
          </Button>
          <Button x:Name="CloseButton"
                  Classes="icon"
                  ToolTip.Tip="Close">
            <TextBlock Classes="materialSymbol" Text="close" />
          </Button>
        </StackPanel>
      </Grid>
    </Grid>

    <!-- Existing status channels stay available to the launcher code but do
         not add a second strip to the WebUI composition. -->
    <Grid x:Name="StatusBar" Grid.Row="2" Height="0" IsVisible="False">
      <TextBlock x:Name="EmulatorPathText" />
      <TextBlock x:Name="StatusBarRight" />
      <TextBlock x:Name="StatusText" />
    </Grid>

    <!-- Portable resize hit targets for the frameless desktop window. -->
    <Border Tag="North"
              Grid.RowSpan="3"
              ZIndex="1000"
              Height="6"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Top"
              Background="#01000000"
              Cursor="TopSide"
              PointerPressed="OnResizeHandlePointerPressed" />
    <Border Tag="South"
              Grid.RowSpan="3"
              ZIndex="1000"
              Height="6"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Bottom"
              Background="#01000000"
              Cursor="BottomSide"
              PointerPressed="OnResizeHandlePointerPressed" />
    <Border Tag="West"
              Grid.RowSpan="3"
              ZIndex="1000"
              Width="6"
              HorizontalAlignment="Left"
              VerticalAlignment="Stretch"
              Background="#01000000"
              Cursor="LeftSide"
              PointerPressed="OnResizeHandlePointerPressed" />
    <Border Tag="East"
              Grid.RowSpan="3"
              ZIndex="1000"
              Width="6"
              HorizontalAlignment="Right"
              VerticalAlignment="Stretch"
              Background="#01000000"
              Cursor="RightSide"
              PointerPressed="OnResizeHandlePointerPressed" />
    <Border Tag="NorthWest"
              Grid.RowSpan="3"
              ZIndex="1001"
              Width="12"
              Height="12"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Background="#01000000"
              Cursor="TopLeftCorner"
              PointerPressed="OnResizeHandlePointerPressed" />
    <Border Tag="NorthEast"
              Grid.RowSpan="3"
              ZIndex="1001"
              Width="12"
              Height="12"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Background="#01000000"
              Cursor="TopRightCorner"
              PointerPressed="OnResizeHandlePointerPressed" />
    <Border Tag="SouthWest"
              Grid.RowSpan="3"
              ZIndex="1001"
              Width="12"
              Height="12"
              HorizontalAlignment="Left"
              VerticalAlignment="Bottom"
              Background="#01000000"
              Cursor="BottomLeftCorner"
              PointerPressed="OnResizeHandlePointerPressed" />
    <Border Tag="SouthEast"
              Grid.RowSpan="3"
              ZIndex="1001"
              Width="12"
              Height="12"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              Background="#01000000"
              Cursor="BottomRightCorner"
              PointerPressed="OnResizeHandlePointerPressed" />

    <primitives:Popup x:Name="SessionBarPopup"
                      IsOpen="False"
                      PlacementTarget="{Binding #GameView}"
                      Placement="Bottom"
                      VerticalOffset="-66"
                      Topmost="True"
                      ShouldUseOverlayLayer="False"
                      TakesFocusFromNativeControl="False"
                      IsLightDismissEnabled="False">
      <Border Background="#F5202023"
              Width="598"
              Height="58"
              CornerRadius="16"
              Padding="14,8"
              BoxShadow="0 10 34 0 #55000000">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="3" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock x:Name="SessionGameTitle"
                         Text="GAME RUNNING"
                         FontSize="13"
                         FontWeight="SemiBold"
                         MaxWidth="240"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" />
              <Border Classes="badge running" VerticalAlignment="Center">
                <TextBlock Text="RUNNING"
                           FontSize="9"
                           FontWeight="Bold"
                           LetterSpacing="1"
                           Foreground="{StaticResource SuccessBrush}" />
              </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Border x:Name="SessionF11Badge" Classes="badge key">
                <TextBlock Text="F11"
                           FontSize="9"
                           FontWeight="Bold"
                           Foreground="{StaticResource InfoBrush}" />
              </Border>
              <TextBlock x:Name="SessionHintText"
                         Text="Fullscreen"
                         FontSize="11"
                         Foreground="{StaticResource MutedBrush}"
                         VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button x:Name="SessionConsoleButton" Classes="ghost">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="materialSymbol" Text="terminal" />
                <TextBlock x:Name="SessionConsoleButtonLabel" Text="Console" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="SessionStopButton" Classes="danger" IsEnabled="False">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="materialSymbol" Text="stop" />
                <TextBlock x:Name="SessionStopButtonLabel" Text="Stop" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </primitives:Popup>

    <primitives:Popup x:Name="SessionLoadingPopup"
                      IsOpen="False"
                      PlacementTarget="{Binding #MainContent}"
                      Placement="Center"
                      Topmost="True"
                      ShouldUseOverlayLayer="False"
                      TakesFocusFromNativeControl="False"
                      IsLightDismissEnabled="False">
      <Border Background="#F5202023"
              Width="380"
              CornerRadius="18"
              Padding="22,18"
              BoxShadow="0 10 34 0 #55000000">
        <StackPanel Spacing="12">
          <TextBlock x:Name="SessionLoadingTitle"
                     Text="Loading game"
                     FontSize="16"
                     FontWeight="SemiBold" />
          <TextBlock x:Name="SessionLoadingDetail"
                     Text="Preparing the emulation session..."
                     FontSize="12"
                     Foreground="{StaticResource MutedBrush}"
                     TextTrimming="CharacterEllipsis" />
          <ProgressBar IsIndeterminate="True" Height="5" />
        </StackPanel>
      </Border>
    </primitives:Popup>
  </Grid>
</Window>
