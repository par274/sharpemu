<Project Sdk="Microsoft.NET.Sdk">

  <!-- Class library: the GUI is hosted by SharpEmu.CLI, which opens it when
       the executable is started without arguments. -->
  <PropertyGroup>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Required by the source-generated LibraryImport stubs in the linked
         controller readers below. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SharpEmuFontSubsetterProject>$(MSBuildThisFileDirectory)Build\FontSubsetter\SharpEmu.GUI.FontSubsetter.csproj</SharpEmuFontSubsetterProject>
  </PropertyGroup>

  <!-- Dependency-free; provides the BuildInfo provenance shown in the
       title bar. -->
  <ItemGroup>
    <!-- The GUI owns the native presentation control while each game runs in
         an isolated emulator process. -->
    <ProjectReference Include="..\SharpEmu.Core\SharpEmu.Core.csproj" />
    <ProjectReference Include="..\SharpEmu.Libs\SharpEmu.Libs.csproj" />
    <ProjectReference Include="..\SharpEmu.Logging\SharpEmu.Logging.csproj" />
    <ProjectReference Include="Build\FontSubsetter\SharpEmu.GUI.FontSubsetter.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SharpEmu.Libs.Tests" />
    <!-- The nested build helper is compiled by its own project, not into the
         launcher assembly. -->
    <Compile Remove="Build\FontSubsetter\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="ReactiveUI.Avalonia" />
    <PackageReference Include="ReactiveUI.SourceGenerators" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" />
    <PackageReference Include="Tmds.DBus.Protocol" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\..\assets\images\SharpEmu.ico" Link="Assets/SharpEmu.ico" />
    <AvaloniaResource Include="..\..\assets\images\logo.png" Link="Assets/logo.png" />
    <AvaloniaResource Include="Assets\logo.svg" />
    <AvaloniaResource Include="Assets\Flags\*.svg" />
    <AvaloniaResource Include="..\..\assets\images\github.png" Link="Assets/github.png" />
    <AvaloniaResource Include="..\..\assets\images\discord.png" Link="Assets/discord.png" />
    <AvaloniaResource Include="..\..\assets\images\update-icon.png" Link="Assets/update-icon.png" />
    <AvaloniaResource Include="..\..\assets\images\commit-icon.png" Link="Assets/commit-icon.png" />
    <AvaloniaResource Include="..\..\assets\images\pic0.png" Link="Assets/pic0.png" />
    <AvaloniaResource Include="Assets\Fonts\GoogleSans-*.ttf" />
    <!-- Keep generated resources explicit so a missing TTF can be recreated
         before resource processing and still participate in the same build. -->
    <AvaloniaResource Include="
        Assets\Fonts\NotoSansJP-Light.ttf;
        Assets\Fonts\NotoSansJP-Regular.ttf;
        Assets\Fonts\NotoSansJP-Medium.ttf;
        Assets\Fonts\NotoSansJP-SemiBold.ttf;
        Assets\Fonts\NotoSansJP-Bold.ttf;
        Assets\Fonts\NotoSansKR-Light.ttf;
        Assets\Fonts\NotoSansKR-Regular.ttf;
        Assets\Fonts\NotoSansKR-Medium.ttf;
        Assets\Fonts\NotoSansKR-SemiBold.ttf;
        Assets\Fonts\NotoSansKR-Bold.ttf" />
    <AvaloniaResource Include="Assets\Fonts\MaterialSymbolsRounded-400.ttf" />
    <None Include="..\..\LICENSES\OFL-1.1.txt"
          Link="licenses\OFL-1.1.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          TargetPath="licenses\OFL-1.1.txt" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Languages\*.json">
      <LogicalName>Languages.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- The C# helper performs its own content-hash check, so ordinary builds
       stay offline and return immediately. Upstream fonts are downloaded only
       after the CJK translations, generator, or generated TTFs change. -->
  <Target Name="UpdateNotoCjkFontSubsets"
          BeforeTargets="PrepareResources"
          DependsOnTargets="ResolveProjectReferences"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SharpEmuSkipNotoSubsetUpdate)' != 'true'">
    <MSBuild Projects="$(SharpEmuFontSubsetterProject)"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)"
             BuildInParallel="false">
      <Output TaskParameter="TargetOutputs"
              ItemName="_SharpEmuFontSubsetterAssembly" />
    </MSBuild>
    <Error Condition="'@(_SharpEmuFontSubsetterAssembly)' == ''"
           Text="Could not resolve the SharpEmu GUI font subsetter." />
    <!-- RepoRoot is normalized with a trailing separator, which would escape
         the closing quote on Windows. Use it as the working directory and pass
         a shell-independent relative path instead. -->
    <Exec Command="dotnet &quot;@(_SharpEmuFontSubsetterAssembly->'%(FullPath)')&quot; ."
          WorkingDirectory="$(RepoRoot)" />
  </Target>
</Project>
