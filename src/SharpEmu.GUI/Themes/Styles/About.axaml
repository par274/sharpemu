About page link actions and their brand icons.
-->

<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia">
    <Style Selector="Button.aboutLinkAction">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="HorizontalContentAlignment" Value="Right" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#A6FFFFFF" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="RenderTransform" Value="none" />
    </Style>
    <Style Selector="Button.aboutLinkAction /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="#A6FFFFFF" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground"
                           Duration="0:0:0.14"
                           Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.aboutLinkAction:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     Button.aboutLinkAction:focus-visible /template/ ContentPresenter#PART_ContentPresenter,
                     Button.aboutLinkAction:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.aboutLinkAction:pressed">
      <Setter Property="RenderTransform" Value="none" />
    </Style>
    <Style Selector="svg|Svg.aboutLinkBrandIcon">
      <Setter Property="Opacity" Value="0.65" />
      <Setter Property="OpacityMask" Value="White" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity"
                            Duration="0:0:0.14"
                            Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.aboutLinkAction:pointerover svg|Svg.aboutLinkBrandIcon,
                     Button.aboutLinkAction:focus-visible svg|Svg.aboutLinkBrandIcon,
                     Button.aboutLinkAction:pressed svg|Svg.aboutLinkBrandIcon">
      <Setter Property="Opacity" Value="1" />
    </Style>
</Styles>
