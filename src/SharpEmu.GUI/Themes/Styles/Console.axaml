Console log list and status badges.
-->

<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="ListBox.console">
      <Setter Property="Background" Value="#D6060606" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="ListBox.console ListBoxItem">
      <Setter Property="Padding" Value="12,1" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.badge.running">
      <Setter Property="Background" Value="#1E66F2A3" />
      <Setter Property="BorderBrush" Value="#5566F2A3" />
    </Style>
    <Style Selector="Border.badge.key">
      <Setter Property="Background" Value="#1E64A7FF" />
      <Setter Property="BorderBrush" Value="#5564A7FF" />
    </Style>
</Styles>
