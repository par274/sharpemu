<!-- Web-based launcher host. The entire launcher UI lives in the bundled Vue
     app rendered by the NativeWebView; this window only owns the WebView, the
     native game surface (a child HWND the emulator renders into), and the
     session popups (which must stay native to float above that child surface).
     The legacy Avalonia MainWindow remains as a fallback. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SharpEmu.GUI"
        xmlns:web="using:Avalonia.Controls"
        xmlns:primitives="clr-namespace:Avalonia.Controls.Primitives;assembly=Avalonia.Controls"
        x:Class="SharpEmu.GUI.WebLauncher"
        Title="SharpEmu"
        Width="1280" Height="820"
        MinWidth="980" MinHeight="640"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#0B0D14"
        WindowDecorations="Full"
        Icon="avares://SharpEmu.GUI/Assets/SharpEmu.ico"
        KeyDown="OnKeyDown">

  <Grid x:Name="RootLayout">
    <!-- Content: the launcher WebView (always on top) over the game surface.
         The WebView is hidden while a game runs so the native child gets the
         full viewport; the popups below float above it natively. -->
    <Grid x:Name="MainContent">
      <!-- The native Vulkan child surface. Parked offscreen (1px corner) until
           the game presents; the host manages visibility, not the size. -->
      <Border x:Name="GameView" IsVisible="False" Background="#000000" ClipToBounds="True">
        <Grid x:Name="GameSurfaceContainer" />
      </Border>

      <!-- The entire launcher UI. Transparent so the game art backdrop (drawn
           in CSS) shows through during transitions. -->
      <web:NativeWebView x:Name="WebView"
                         Background="Transparent"
                         NavigationCompleted="OnNavigationCompleted" />
    </Grid>

    <!-- Session bar: floating "game running" controls. Native (not Avalonia
         overlay) because it must sit above the native game child window. -->
    <primitives:Popup x:Name="SessionBarPopup"
                      IsOpen="False"
                      PlacementTarget="{Binding #GameView}"
                      Placement="Bottom"
                      VerticalOffset="-66"
                      Topmost="True"
                      ShouldUseOverlayLayer="False"
                      TakesFocusFromNativeControl="False"
                      IsLightDismissEnabled="False">
      <Border Background="#141924" BorderBrush="#232B3A" BorderThickness="1"
              CornerRadius="16" Padding="14,8" Width="598" Height="58">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="3" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock x:Name="SessionGameTitle" Text="GAME RUNNING" FontSize="13" FontWeight="SemiBold"
                         MaxWidth="240" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <Border CornerRadius="999" Padding="8,2" BorderThickness="1"
                      Background="#1E46C46B" BorderBrush="#5546C46B" VerticalAlignment="Center">
                <TextBlock Text="RUNNING" FontSize="9" FontWeight="Bold" LetterSpacing="1" Foreground="#46C46B" />
              </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Border CornerRadius="999" Padding="8,2" BorderThickness="1"
                      Background="#1E58A6FF" BorderBrush="#5558A6FF" VerticalAlignment="Center">
                <TextBlock x:Name="SessionF11Badge" Text="F11" FontSize="9" FontWeight="Bold" Foreground="#58A6FF" />
              </Border>
              <TextBlock x:Name="SessionHintText" Text="Fullscreen" FontSize="11"
                         Foreground="#8B94A7" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button x:Name="SessionConsoleButton" Click="OnSessionConsole" Content="≡ Console"
                    Background="Transparent" BorderBrush="#232B3A" BorderThickness="1"
                    Foreground="#E8ECF4" Padding="12,7" CornerRadius="8" />
            <Button x:Name="SessionStopButton" Click="OnSessionStop" Content="■  Stop" IsEnabled="False"
                    Background="#E5484D" Foreground="White" FontWeight="SemiBold" Padding="22,10" CornerRadius="8" />
          </StackPanel>
        </Grid>
      </Border>
    </primitives:Popup>

    <!-- Loading popup while a session is starting/closing. Native for the same
         z-order reason as the session bar. Anchored to MainContent (not GameView)
         because the surface host is parked offscreen during load. -->
    <primitives:Popup x:Name="SessionLoadingPopup"
                      IsOpen="False"
                      PlacementTarget="{Binding #MainContent}"
                      Placement="Center"
                      Topmost="True"
                      ShouldUseOverlayLayer="False"
                      TakesFocusFromNativeControl="False"
                      IsLightDismissEnabled="False">
      <Border Background="#141924" BorderBrush="#232B3A" BorderThickness="1"
              Width="380" CornerRadius="18" Padding="22,18">
        <StackPanel Spacing="12">
          <TextBlock x:Name="SessionLoadingTitle" Text="Loading game" FontSize="16" FontWeight="SemiBold" />
          <TextBlock x:Name="SessionLoadingDetail" Text="Preparing the emulation session..." FontSize="12"
                     Foreground="#8B94A7" TextTrimming="CharacterEllipsis" />
          <ProgressBar IsIndeterminate="True" Height="5" />
        </StackPanel>
      </Border>
    </primitives:Popup>
  </Grid>
</Window>
