                           Duration="0:0:0.18"
                           Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="TextBox.consoleSearch:pointerover /template/ Border#PART_BorderElement,
                     TextBox.consoleSearch:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#20FFFFFF" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBlock.consoleSearchIcon">
      <Setter Property="Margin" Value="14,0,8,0" />
      <Setter Property="Foreground" Value="#8FFFFFFF" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground"
                           Duration="0:0:0.18"
                           Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="TextBox.consoleSearch:pointerover TextBlock.consoleSearchIcon,
                     TextBox.consoleSearch:focus TextBlock.consoleSearchIcon">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="TextBox.consoleSearch:pointerover,
                     TextBox.consoleSearch:focus">
      <Setter Property="PlaceholderForeground" Value="White" />
    </Style>

    <!-- Rounded selectors used by both global and per-game settings. The native
         ComboBox template remains intact for keyboard, focus, and XY/gamepad navigation. -->
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="17,0,48,0" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="#12FFFFFF" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#E8FFFFFF" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="MaxDropDownHeight" Value="360" />
      <Setter Property="ItemTemplate">
        <DataTemplate>
          <TextBlock Text="{Binding}"
                     TextTrimming="CharacterEllipsis"
                     TextWrapping="NoWrap"
                     VerticalAlignment="Center" />
        </DataTemplate>
      </Setter>
    </Style>
    <Style Selector="ComboBox /template/ Border#Background">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background"
                           Duration="0:0:0.18"
                           Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#Background,
                     ComboBox:focus-visible /template/ Border#Background,
                     ComboBox:dropdownopen /template/ Border#Background">
      <Setter Property="Background" Value="#20FFFFFF" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ComboBox /template/ PathIcon#DropDownGlyph">
      <!-- Material Icons Rounded: expand_more. -->
      <Setter Property="Data" Value="M7.41,8.59 L12,13.17 L16.59,8.59 L18,10 L12,16 L6,10 Z" />
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Margin" Value="0,0,22,0" />
      <Setter Property="Foreground" Value="#B8FFFFFF" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform"
                                         Duration="0:0:0.22"
                                         Easing="CubicEaseOut" />
          <BrushTransition Property="Foreground"
                           Duration="0:0:0.18"
                           Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ComboBox:pointerover /template/ PathIcon#DropDownGlyph,
                     ComboBox:focus-visible /template/ PathIcon#DropDownGlyph,
                     ComboBox:dropdownopen /template/ PathIcon#DropDownGlyph">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ComboBox:dropdownopen /template/ PathIcon#DropDownGlyph">
      <Setter Property="RenderTransform" Value="rotate(180deg)" />
    </Style>

    <Style Selector="Border.animatedComboPopup">
      <Setter Property="Padding" Value="6" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Background" Value="#FC2A2A2A" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BoxShadow" Value="0 18 44 0 #78000000" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransformOrigin" Value="50%,0%" />
      <Setter Property="RenderTransform" Value="translateY(-7px) scale(0.975)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity"
                            Duration="0:0:0.15"
                            Easing="CubicEaseOut" />
          <TransformOperationsTransition Property="RenderTransform"
                                         Duration="0:0:0.18"
                                         Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.animatedComboPopup.open">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="translateY(0px) scale(1)" />
    </Style>

    <Style Selector="ComboBoxItem">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="Padding" Value="13,0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#C8FFFFFF" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background"
                           Duration="0:0:0.16"
                           Easing="CubicEaseOut" />
          <BrushTransition Property="Foreground"
                           Duration="0:0:0.16"
                           Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     ComboBoxItem:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#14FFFFFF" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#22FFFFFF" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ComboBox.languageValue /template/ ContentControl#ContentPresenter">
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="ContextMenu">
      <Setter Property="Width" Value="390" />
      <Setter Property="Background" Value="#FA202020" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="ContextMenu MenuItem">
      <Setter Property="MinHeight" Value="50" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Foreground" Value="#D1FFFFFF" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="Light" />
    </Style>
    <Style Selector="ContextMenu MenuItem:pointerover">
      <Setter Property="Background" Value="#0CFFFFFF" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ContextMenu Separator">
      <Setter Property="Background" Value="#14FFFFFF" />
      <Setter Property="Height" Value="1" />
      <Setter Property="Margin" Value="14,5" />
    </Style>

    <Style Selector="ListBox.tileGrid">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style Selector="ListBox.tileGrid ListBoxItem">
      <Setter Property="Width" Value="156" />
      <Setter Property="Height" Value="206" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="Margin" Value="0,10,12,20" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Opacity" Value="0.68" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform" Value="translateY(0px)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity"
                            Duration="0:0:0.11"
                            Easing="QuadraticEaseOut" />
          <TransformOperationsTransition Property="RenderTransform"
                                         Duration="0:0:0.16"
                                         Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBox.tileGrid ListBoxItem:pointerover,
                     ListBox.tileGrid ListBoxItem:selected">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="translateY(-7px) scale(1.045)" />
    </Style>
    <Style Selector="ListBox.tileGrid ListBoxItem /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.tileGrid ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.tileGrid ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="White" />
    </Style>

    <Style Selector="Border.coverShadow">
      <Setter Property="BoxShadow" Value="0 12 28 0 #61000000" />
    </Style>
    <Style Selector="Border.libraryGameCard">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform" Value="translateY(8px) scale(0.985)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity"
                            Duration="0:0:0.2"
                            Easing="CubicEaseOut" />
          <TransformOperationsTransition Property="RenderTransform"
                                         Duration="0:0:0.24"
                                         Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.libraryGameCard.ready">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="translateY(0px) scale(1)" />
    </Style>
    <Style Selector="TextBlock.libraryCardInitials,
                     Image.libraryCardCover,
                     TextBlock.libraryCardSpinner">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity"
                            Duration="0:0:0.18"
                            Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="TextBlock.libraryCardInitials.ready,
                     Image.libraryCardCover.ready,
                     TextBlock.libraryCardSpinner.loading">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="TextBlock.libraryCardSpinner">
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    </Style>
    <Style Selector="TextBlock.libraryCardSpinner.loading">
      <Style.Animations>
        <Animation Duration="0:0:0.82"
                   IterationCount="Infinite"
                   Easing="LinearEasing">
          <KeyFrame Cue="0%">
            <Setter Property="RotateTransform.Angle" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="RotateTransform.Angle" Value="360" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Border.coverClip">
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Background" Value="#1C1C1C" />
    </Style>

    <!-- Trailing "add folder" action tile in the library carousel. It matches a
         game cover's footprint but reads as an affordance, not content. -->
    <Style Selector="Border.addFolderTile">
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="#0CFFFFFF" />
      <Setter Property="BorderBrush" Value="#2EFFFFFF" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="BoxShadow" Value="0 12 28 0 #3A000000" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseOut" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.addFolderTileIcon">
      <Setter Property="Width" Value="60" />
      <Setter Property="Height" Value="60" />
      <Setter Property="CornerRadius" Value="30" />
      <Setter Property="Background" Value="#1BFFFFFF" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <!-- Tile glyph + label share one rest color and animate to pure white on
         hover, matching the icon to the label color as requested. -->
    <Style Selector="TextBlock.addFolderGlyph">
      <Setter Property="Foreground" Value="#A6FFFFFF" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <!-- Optical compensation: the "add" Material Symbols glyph sits a hair below
         its em-box center, so nudge it up to sit centered in the round badge. -->
    <Style Selector="TextBlock.addFolderIconGlyph">
      <Setter Property="RenderTransform" Value="translateY(-2px)" />
    </Style>
    <Style Selector="ListBox.tileGrid ListBoxItem:pointerover TextBlock.addFolderGlyph,
                     ListBox.tileGrid ListBoxItem:selected TextBlock.addFolderGlyph">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ListBox.tileGrid ListBoxItem:pointerover Border.addFolderTile">
      <Setter Property="Background" Value="#1AFFFFFF" />
    </Style>
    <Style Selector="ListBox.tileGrid ListBoxItem:selected Border.addFolderTile">
      <Setter Property="Background" Value="#1AFFFFFF" />
      <Setter Property="BorderBrush" Value="#55FFFFFF" />
    </Style>
    <Style Selector="ListBox.tileGrid ListBoxItem:pointerover Border.addFolderTileIcon,
                     ListBox.tileGrid ListBoxItem:selected Border.addFolderTileIcon">
      <Setter Property="Background" Value="#2EFFFFFF" />
    </Style>

    <Style Selector="ListBox.console">
      <Setter Property="Background" Value="#D6060606" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="ListBox.console ListBoxItem">
      <Setter Property="Padding" Value="12,1" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.badge.running">
      <Setter Property="Background" Value="#1E66F2A3" />
      <Setter Property="BorderBrush" Value="#5566F2A3" />
    </Style>
    <Style Selector="Border.badge.key">
      <Setter Property="Background" Value="#1E64A7FF" />
      <Setter Property="BorderBrush" Value="#5564A7FF" />
    </Style>
  </Application.Styles>
</Application>
