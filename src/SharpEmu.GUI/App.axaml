    <!-- Material Symbols Rounded has an asymmetric line box: its visible ink
         sits about 2.5 px below the line-box center. Bottom padding expands
         the measured box and moves the ink up while the row stays centered. -->
    <Style Selector="TextBlock.optionsNavIcon">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="VerticalAlignment" Value="Center" />
