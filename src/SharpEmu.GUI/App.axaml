    <Style Selector="CheckBox.consoleAutoScroll">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="15,0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="#12FFFFFF" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#B8FFFFFF" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="PART_ConsoleAutoScrollBackground"
                  MinHeight="{TemplateBinding MinHeight}"
                  Padding="{TemplateBinding Padding}"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  BorderBrush="Transparent"
                  BorderThickness="0">
            <Grid ColumnDefinitions="Auto,12,20">
              <ContentPresenter Grid.Column="0"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                VerticalContentAlignment="Center" />
              <Border x:Name="PART_ConsoleAutoScrollIndicator"
                      Grid.Column="2"
                      Width="20"
                      Height="20"
                      VerticalAlignment="Center"
                      Background="#1FFFFFFF"
                      BorderBrush="Transparent"
                      BorderThickness="0"
                      CornerRadius="6">
                <TextBlock x:Name="PART_ConsoleAutoScrollGlyph"
                           Classes="materialSymbol compact"
                           Text="check"
                           FontSize="15"
                           Foreground="#111111"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Opacity="0"
                           RenderTransform="scale(0.6)" />
              </Border>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="CheckBox.consoleAutoScroll /template/ Border#PART_ConsoleAutoScrollBackground">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background"
                           Duration="0:0:0.18"
                           Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="CheckBox.consoleAutoScroll:pointerover /template/ Border#PART_ConsoleAutoScrollBackground,
                     CheckBox.consoleAutoScroll:focus-visible /template/ Border#PART_ConsoleAutoScrollBackground">
      <Setter Property="Background" Value="#20FFFFFF" />
    </Style>
